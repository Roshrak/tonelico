#!/usr/bin/env python3
import html
import json
import mimetypes
import os
import pathlib
import queue
import re
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

HOME = pathlib.Path(os.environ.get("HOME", "/home/aesc"))
STATE_DIR = HOME / ".claude" / "telegram-bridge"
INBOX_DIR = STATE_DIR / "inbox"
STATE_FILE = STATE_DIR / "state.json"
PROJECTS_DIR = HOME / ".claude" / "projects"

def _read_hermes_allowed_user() -> str:
    env_file = HOME / ".hermes" / ".env"
    try:
        lines = env_file.read_text(encoding="utf-8").splitlines()
    except OSError:
        return ""
    value = ""
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if stripped.startswith("export "):
            stripped = stripped[7:].lstrip()
        key, sep, raw = stripped.partition("=")
        if sep and key.strip() == "TELEGRAM_ALLOWED_USERS":
            raw = raw.strip()
            if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in ('"', "'"):
                raw = raw[1:-1].strip()
            elif "#" in raw:
                raw = raw.split("#", 1)[0].strip()
            first = raw.split(",", 1)[0].strip().strip('"').strip("'")
            if first:
                value = first
    return value


def _load_allowed_user_id() -> int:
    raw = os.environ.get("CLAUDE_TG_ALLOWED_USER_ID", "").strip()
    source = "CLAUDE_TG_ALLOWED_USER_ID"
    if not raw:
        raw = _read_hermes_allowed_user()
        source = "TELEGRAM_ALLOWED_USERS in ~/.hermes/.env"
    if not raw:
        print(
            "ERROR: CLAUDE_TG_ALLOWED_USER_ID is not set and TELEGRAM_ALLOWED_USERS was not found in ~/.hermes/.env",
            file=sys.stderr,
        )
        sys.exit(1)
    try:
        uid = int(raw)
    except ValueError:
        print(f"ERROR: {source} must be an integer", file=sys.stderr)
        sys.exit(1)
    if uid <= 0:
        print(f"ERROR: {source} must be a positive integer", file=sys.stderr)
        sys.exit(1)
    return uid


BOT_TOKEN = os.environ.get("CLAUDE_TG_BOT_TOKEN", "").strip()
CLAUDE_TIMEOUT = int(os.environ.get("CLAUDE_TELEGRAM_BRIDGE_TIMEOUT", "1800"))

if not BOT_TOKEN:
    print("ERROR: CLAUDE_TG_BOT_TOKEN is not set", file=sys.stderr)
    sys.exit(1)

ALLOWED_USER_ID = _load_allowed_user_id()

API_BASE = f"https://api.telegram.org/bot{BOT_TOKEN}"
FILE_BASE = f"https://api.telegram.org/file/bot{BOT_TOKEN}"

TELEGRAM_HINT = (
    "You are replying through a Telegram bridge to Trong. "
    "Keep responses crisp, structured, and easy to read on mobile. "
    "If you generate a file/image/chart for the user to receive in Telegram, "
    "put MEDIA:/absolute/path/to/file on its own line."
)

STATE_LOCK = threading.Lock()
JOB_QUEUE: queue.Queue = queue.Queue(maxsize=16)

ACTIVE_LOCK = threading.Lock()
ACTIVE_PROC: subprocess.Popen | None = None
ACTIVE_CANCELLED = False
ACTIVE_STARTED_AT = 0.0
ACTIVE_PROMPT_PREVIEW = ""
ACTIVE_CHAT_ID: int | None = None


def log(msg: str) -> None:
    ts = time.strftime("%Y-%m-%d %H:%M:%S")
    print(f"[{ts}] {msg}", flush=True)


def load_state() -> dict:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    INBOX_DIR.mkdir(parents=True, exist_ok=True)
    default = {
        "session_id": None,
        "cwd": str(HOME),
        "model": None,
        "effort": None,
        "update_offset": 0,
        "chat_id": ALLOWED_USER_ID,
        "last_rate_limit": None,
    }
    if not STATE_FILE.exists():
        return default
    try:
        data = json.loads(STATE_FILE.read_text())
        default.update(data)
    except Exception as exc:
        log(f"WARN: failed to parse state.json: {exc}")
    if not os.path.isdir(default.get("cwd") or ""):
        default["cwd"] = str(HOME)
    return default


def save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(state, indent=2))
    tmp.replace(STATE_FILE)


STATE = load_state()


def tg_call(method: str, payload: dict | None = None, timeout: int = 45) -> dict:
    url = f"{API_BASE}/{method}"
    body = json.dumps(payload or {}).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        err_body = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"Telegram {method} HTTP {exc.code}: {err_body}") from exc


def tg_upload(method: str, field: str, file_path: pathlib.Path, chat_id: int, caption: str = "") -> dict:
    boundary = f"----HermesClaudeBridge{uuid.uuid4().hex}"
    parts: list[bytes] = []

    def add_field(name: str, value: str) -> None:
        parts.append(
            f"--{boundary}\r\nContent-Disposition: form-data; name=\"{name}\"\r\n\r\n{value}\r\n".encode("utf-8")
        )

    add_field("chat_id", str(chat_id))
    if caption:
        add_field("caption", caption[:1000])

    mime = mimetypes.guess_type(str(file_path))[0] or "application/octet-stream"
    file_bytes = file_path.read_bytes()
    header = (
        f"--{boundary}\r\n"
        f"Content-Disposition: form-data; name=\"{field}\"; filename=\"{file_path.name}\"\r\n"
        f"Content-Type: {mime}\r\n\r\n"
    ).encode("utf-8")
    parts.append(header + file_bytes + b"\r\n")
    parts.append(f"--{boundary}--\r\n".encode("utf-8"))

    body = b"".join(parts)
    req = urllib.request.Request(
        f"{API_BASE}/{method}",
        data=body,
        headers={"Content-Type": f"multipart/form-data; boundary={boundary}"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        return json.loads(resp.read().decode("utf-8"))


def md_to_tg_html(text: str) -> str:
    tokens: list[str] = []

    def stash(html_snippet: str) -> str:
        idx = len(tokens)
        tokens.append(html_snippet)
        return f"\x00T{idx}\x00"

    def repl_code_block(m: re.Match) -> str:
        lang = m.group(1) or ""
        code = html.escape(m.group(2).rstrip("\n"))
        if lang:
            return stash(f'<pre><code class="language-{html.escape(lang)}">{code}</code></pre>')
        return stash(f"<pre><code>{code}</code></pre>")

    def repl_inline_code(m: re.Match) -> str:
        return stash(f"<code>{html.escape(m.group(1))}</code>")

    out = re.sub(r"```([A-Za-z0-9_+-]*)\n(.*?)```", repl_code_block, text, flags=re.DOTALL)
    out = re.sub(r"`([^`\n]+)`", repl_inline_code, out)
    out = html.escape(out)
    out = re.sub(r"\[([^\]\n]+)\]\((https?://[^\s)]+)\)", r'<a href="\2">\1</a>', out)
    out = re.sub(r"\*\*([^\n*][^*]*?)\*\*", r"<b>\1</b>", out)
    out = re.sub(r"^#{1,6}\s+(.+)$", r"<b>\1</b>", out, flags=re.MULTILINE)

    for idx, snippet in enumerate(tokens):
        out = out.replace(f"\x00T{idx}\x00", snippet)
    return out


def chunk_text(text: str, limit: int = 3800) -> list[str]:
    text = text.strip() or "(empty response)"
    if len(text) <= limit:
        return [text]

    chunks: list[str] = []
    remaining = text
    while remaining:
        if len(remaining) <= limit:
            chunks.append(remaining)
            break
        split_at = remaining.rfind("\n\n", 0, limit)
        if split_at < limit // 3:
            split_at = remaining.rfind("\n", 0, limit)
        if split_at < limit // 3:
            split_at = remaining.rfind(" ", 0, limit)
        if split_at < 1:
            split_at = limit
        chunk = remaining[:split_at].rstrip()
        remaining = remaining[split_at:].lstrip()
        # Balance unclosed fenced code blocks cleanly across chunks
        if chunk.count("```") % 2 == 1:
            chunk += "\n```"
            remaining = "```\n" + remaining
        chunks.append(chunk)
    return chunks


def send_message(chat_id: int, text: str, reply_to: int | None = None, use_html: bool = True) -> int | None:
    payload: dict = {"chat_id": chat_id, "disable_web_page_preview": True}
    if reply_to:
        payload["reply_to_message_id"] = reply_to
    if use_html:
        payload["text"] = md_to_tg_html(text)
        payload["parse_mode"] = "HTML"
    else:
        payload["text"] = text
    try:
        res = tg_call("sendMessage", payload)
        return res.get("result", {}).get("message_id")
    except Exception:
        if use_html:
            payload["text"] = text
            payload.pop("parse_mode", None)
            res = tg_call("sendMessage", payload)
            return res.get("result", {}).get("message_id")
        raise


def send_long_reply(chat_id: int, text: str, reply_to: int | None = None) -> None:
    media_paths: list[pathlib.Path] = []
    clean_lines: list[str] = []
    for line in text.splitlines():
        m = re.match(r"^\s*MEDIA:(/.+)$", line)
        if m:
            p = pathlib.Path(m.group(1).strip())
            if p.is_file():
                media_paths.append(p)
                continue
        clean_lines.append(line)

    cleaned = "\n".join(clean_lines).strip()
    if cleaned or not media_paths:
        for idx, chunk in enumerate(chunk_text(cleaned or "Done.")):
            send_message(chat_id, chunk, reply_to=reply_to if idx == 0 else None, use_html=True)

    for path in media_paths:
        try:
            if path.suffix.lower() in {".png", ".jpg", ".jpeg", ".webp"}:
                tg_upload("sendPhoto", "photo", path, chat_id)
            else:
                tg_upload("sendDocument", "document", path, chat_id)
        except Exception as exc:
            send_message(chat_id, f"Failed to send file `{path}`: {exc}", use_html=True)


def edit_message(chat_id: int, message_id: int, text: str) -> None:
    try:
        tg_call(
            "editMessageText",
            {
                "chat_id": chat_id,
                "message_id": message_id,
                "text": md_to_tg_html(text),
                "parse_mode": "HTML",
                "disable_web_page_preview": True,
            },
        )
    except Exception:
        pass


def delete_message(chat_id: int, message_id: int) -> None:
    try:
        tg_call("deleteMessage", {"chat_id": chat_id, "message_id": message_id})
    except Exception:
        pass


def send_typing(chat_id: int) -> None:
    try:
        tg_call("sendChatAction", {"chat_id": chat_id, "action": "typing"}, timeout=10)
    except Exception:
        pass


def register_commands() -> None:
    commands = [
        {"command": "start", "description": "Bot status and quick guide"},
        {"command": "new", "description": "Start a new Claude session [/new [cwd]]"},
        {"command": "sessions", "description": "List recent local & Telegram sessions"},
        {"command": "resume", "description": "Resume session [/resume <#|uuid>]"},
        {"command": "cd", "description": "Change working directory [/cd <path>]"},
        {"command": "model", "description": "Set model [default|sonnet|opus|haiku]"},
        {"command": "effort", "description": "Set effort [default|low|medium|high|max]"},
        {"command": "status", "description": "Show active session, cwd, and limits"},
        {"command": "stop", "description": "Abort running Claude task"},
        {"command": "help", "description": "Show command cheatsheet"},
    ]
    try:
        tg_call("setMyCommands", {"commands": commands})
    except Exception as exc:
        log(f"WARN: setMyCommands failed: {exc}")


def list_recent_sessions(limit: int = 8) -> list[dict]:
    files: list[tuple[float, pathlib.Path]] = []
    if PROJECTS_DIR.exists():
        for p in PROJECTS_DIR.glob("*/*.jsonl"):
            try:
                st = p.stat()
                if st.st_size > 200:
                    files.append((st.st_mtime, p))
            except OSError:
                continue
    files.sort(key=lambda item: item[0], reverse=True)

    results: list[dict] = []
    for mtime, path in files[:limit]:
        sid = path.stem
        preview = ""
        cwd = ""
        try:
            with path.open("r", encoding="utf-8", errors="replace") as f:
                for idx, line in enumerate(f):
                    if idx > 80:
                        break
                    try:
                        obj = json.loads(line)
                    except Exception:
                        continue
                    if not cwd and isinstance(obj.get("cwd"), str):
                        cwd = obj["cwd"]
                    if obj.get("type") == "user" and not preview:
                        msg = obj.get("message", {})
                        content = msg.get("content")
                        if isinstance(content, str):
                            preview = content.strip()
                        elif isinstance(content, list):
                            for item in content:
                                if isinstance(item, dict) and item.get("type") == "text":
                                    preview = item.get("text", "").strip()
                                    if preview:
                                        break
                        # strip injected attachment prefix if short
                        preview = re.sub(r"\s+", " ", preview)[:70]
                    if cwd and preview:
                        break
        except Exception:
            pass
        results.append(
            {
                "session_id": sid,
                "mtime": time.strftime("%m-%d %H:%M", time.localtime(mtime)),
                "cwd": cwd or "?",
                "preview": preview or "(no text preview)",
            }
        )
    return results


def download_telegram_file(file_id: str, suggested_name: str) -> pathlib.Path:
    info = tg_call("getFile", {"file_id": file_id})
    remote_path = info["result"]["file_path"]
    ext = pathlib.Path(remote_path).suffix or pathlib.Path(suggested_name).suffix
    safe_base = re.sub(r"[^A-Za-z0-9._-]+", "_", pathlib.Path(suggested_name).stem)[:40] or "attachment"
    out_path = INBOX_DIR / f"{int(time.time())}_{safe_base}{ext}"
    with urllib.request.urlopen(f"{FILE_BASE}/{remote_path}", timeout=60) as resp:
        out_path.write_bytes(resp.read())
    return out_path


def format_status() -> str:
    with STATE_LOCK:
        sid = STATE.get("session_id") or "(new on next message)"
        cwd = STATE.get("cwd") or str(HOME)
        model = STATE.get("model") or "default (CLAUDE.md / Opus)"
        effort = STATE.get("effort") or "default"
        rl = STATE.get("last_rate_limit")
    with ACTIVE_LOCK:
        running = ACTIVE_PROC is not None and ACTIVE_PROC.poll() is None
        elapsed = int(time.time() - ACTIVE_STARTED_AT) if running else 0
        preview = ACTIVE_PROMPT_PREVIEW

    lines = [
        "**Tonelico Claude Bridge**",
        f"• **State:** {'Running (' + str(elapsed) + 's)' if running else 'Idle'}",
        f"• **Session:** `{sid}`",
        f"• **CWD:** `{cwd}`",
        f"• **Model:** `{model}` | **Effort:** `{effort}`",
        "• **Guardrails:** `agy-control` MCP ON | `/home/aesc/tonelico` & `Roshrak/*` HARD-BLOCKED",
    ]
    if running and preview:
        lines.append(f"• **Active task:** `{preview}`")
    if isinstance(rl, dict):
        u5 = rl.get("five_hour", {}).get("utilization")
        u7 = rl.get("seven_day", {}).get("utilization")
        if u5 is not None or u7 is not None:
            p5 = f"{int(u5 * 100)}%" if u5 is not None else "?"
            p7 = f"{int(u7 * 100)}%" if u7 is not None else "?"
            lines.append(f"• **Claude quota:** 5h `{p5}` | 7d `{p7}`")
    if STATE.get("session_id"):
        lines.append(f"• **Terminal handoff:** `claude --resume {STATE['session_id']}`")
    return "\n".join(lines)


def handle_command(chat_id: int, msg_id: int, text: str) -> bool:
    parts = text.strip().split(maxsplit=1)
    cmd = parts[0].split("@")[0].lower()
    arg = parts[1].strip() if len(parts) > 1 else ""

    if cmd in {"/start", "/help"}:
        help_txt = (
            "**Tonelico Claude Code Bot**\n"
            "Send any message, photo, or file to run Claude Code on your laptop.\n\n"
            "**Commands:**\n"
            "• `/new [path]` — Start a fresh session\n"
            "• `/sessions` — List 8 recent sessions (CLI + Telegram)\n"
            "• `/resume <# or uuid>` — Resume a session\n"
            "• `/cd <path>` — Change working directory\n"
            "• `/model [default|opus|sonnet|haiku]` — Switch model\n"
            "• `/effort [default|low|medium|high|max]` — Switch effort\n"
            "• `/status` — Show session, CWD, quota, and guardrails\n"
            "• `/stop` — Cancel the currently running turn\n\n"
            + format_status()
        )
        send_long_reply(chat_id, help_txt, reply_to=msg_id)
        return True

    if cmd == "/status":
        send_long_reply(chat_id, format_status(), reply_to=msg_id)
        return True

    if cmd == "/stop":
        with ACTIVE_LOCK:
            proc = ACTIVE_PROC
            if proc is not None and proc.poll() is None:
                global ACTIVE_CANCELLED
                ACTIVE_CANCELLED = True
                try:
                    os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
                except Exception:
                    proc.terminate()
                send_message(chat_id, "🛑 Stopping active Claude turn…", reply_to=msg_id, use_html=False)
            else:
                send_message(chat_id, "Nothing running right now.", reply_to=msg_id, use_html=False)
        return True

    if cmd == "/new":
        new_cwd = None
        if arg:
            candidate = os.path.expanduser(arg)
            if not os.path.isdir(candidate):
                send_message(chat_id, f"Directory not found: `{candidate}`", reply_to=msg_id)
                return True
            new_cwd = os.path.abspath(candidate)
        with STATE_LOCK:
            STATE["session_id"] = None
            if new_cwd:
                STATE["cwd"] = new_cwd
            save_state(STATE)
            cwd_now = STATE["cwd"]
        send_message(chat_id, f"✨ Started fresh Claude session.\nCWD: `{cwd_now}`", reply_to=msg_id)
        return True

    if cmd == "/cd":
        if not arg:
            with STATE_LOCK:
                cwd_now = STATE["cwd"]
            send_message(chat_id, f"Current CWD: `{cwd_now}`\nUsage: `/cd ~/Projects`", reply_to=msg_id)
            return True
        candidate = os.path.abspath(os.path.expanduser(arg))
        if not os.path.isdir(candidate):
            send_message(chat_id, f"Directory not found: `{candidate}`", reply_to=msg_id)
            return True
        with STATE_LOCK:
            STATE["cwd"] = candidate
            save_state(STATE)
        send_message(chat_id, f"📁 CWD set to `{candidate}`", reply_to=msg_id)
        return True

    if cmd == "/model":
        if not arg:
            with STATE_LOCK:
                m = STATE.get("model") or "default"
            send_message(chat_id, f"Current model: `{m}`\nUsage: `/model default|opus|sonnet|haiku|<id>`", reply_to=msg_id)
            return True
        val = None if arg.lower() in {"default", "reset", "auto"} else arg
        with STATE_LOCK:
            STATE["model"] = val
            save_state(STATE)
        send_message(chat_id, f"🧠 Model set to `{val or 'default'}`", reply_to=msg_id)
        return True

    if cmd == "/effort":
        valid = {"default", "reset", "low", "medium", "high", "max"}
        if not arg:
            with STATE_LOCK:
                ef = STATE.get("effort") or "default"
            send_message(chat_id, f"Current effort: `{ef}`\nUsage: `/effort default|low|medium|high|max`", reply_to=msg_id)
            return True
        if arg.lower() not in valid:
            send_message(chat_id, "Valid efforts: `default`, `low`, `medium`, `high`, `max`", reply_to=msg_id)
            return True
        val = None if arg.lower() in {"default", "reset"} else arg.lower()
        with STATE_LOCK:
            STATE["effort"] = val
            save_state(STATE)
        send_message(chat_id, f"⚡ Effort set to `{val or 'default'}`", reply_to=msg_id)
        return True

    if cmd == "/sessions":
        sessions = list_recent_sessions(8)
        if not sessions:
            send_message(chat_id, "No local Claude sessions found.", reply_to=msg_id, use_html=False)
            return True
        with STATE_LOCK:
            cur = STATE.get("session_id")
        lines = ["**Recent Claude Sessions** (use `/resume <#>`):"]
        for i, s in enumerate(sessions, 1):
            mark = " ✅" if s["session_id"] == cur else ""
            lines.append(
                f"{i}. `{s['session_id'][:8]}` ({s['mtime']}){mark}\n"
                f"   `{s['cwd']}` — {s['preview']}"
            )
        send_long_reply(chat_id, "\n".join(lines), reply_to=msg_id)
        return True

    if cmd == "/resume":
        if not arg:
            send_message(chat_id, "Usage: `/resume <#|uuid>` (see `/sessions`)", reply_to=msg_id)
            return True
        target_sid = arg
        target_cwd = None
        if arg.isdigit():
            idx = int(arg) - 1
            sessions = list_recent_sessions(8)
            if idx < 0 or idx >= len(sessions):
                send_message(chat_id, f"Invalid session index `{arg}`. Run `/sessions` first.", reply_to=msg_id)
                return True
            target_sid = sessions[idx]["session_id"]
            if os.path.isdir(sessions[idx]["cwd"]):
                target_cwd = sessions[idx]["cwd"]
        elif len(arg) < 32:
            sessions = list_recent_sessions(30)
            matches = [s for s in sessions if s["session_id"].startswith(arg)]
            if len(matches) == 1:
                target_sid = matches[0]["session_id"]
                if os.path.isdir(matches[0]["cwd"]):
                    target_cwd = matches[0]["cwd"]
            elif len(matches) > 1:
                send_message(chat_id, f"Multiple sessions match `{arg}`; paste full UUID or index.", reply_to=msg_id)
                return True
        with STATE_LOCK:
            STATE["session_id"] = target_sid
            if target_cwd:
                STATE["cwd"] = target_cwd
            save_state(STATE)
            cwd_now = STATE["cwd"]
        send_message(chat_id, f"🔄 Resumed `{target_sid}`\nCWD: `{cwd_now}`", reply_to=msg_id)
        return True

    return False


def run_claude_turn(chat_id: int, msg_id: int, prompt: str) -> None:
    global ACTIVE_PROC, ACTIVE_CANCELLED, ACTIVE_STARTED_AT, ACTIVE_PROMPT_PREVIEW, ACTIVE_CHAT_ID

    with STATE_LOCK:
        session_id = STATE.get("session_id")
        cwd = STATE.get("cwd") or str(HOME)
        model = STATE.get("model")
        effort = STATE.get("effort")

    if not os.path.isdir(cwd):
        cwd = str(HOME)

    cmd = [
        "claude",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--permission-mode",
        "bypassPermissions",
        "--append-system-prompt",
        TELEGRAM_HINT,
    ]
    if session_id:
        cmd.extend(["--resume", session_id])
    if model:
        cmd.extend(["--model", model])
    if effort:
        cmd.extend(["--effort", effort])
    cmd.append(prompt)

    status_msg_id = send_message(chat_id, "⏳ Claude working…", reply_to=msg_id, use_html=False)
    stop_typing = threading.Event()

    def typing_loop() -> None:
        while not stop_typing.is_set():
            send_typing(chat_id)
            stop_typing.wait(4.5)

    typing_thread = threading.Thread(target=typing_loop, daemon=True)
    typing_thread.start()

    start_ts = time.time()
    tool_count = 0
    last_tool = ""
    last_edit_ts = start_ts
    final_result_text = ""
    collected_text_chunks: list[str] = []
    discovered_sid = session_id
    denials: list[dict] = []
    is_error = False
    timed_out = False

    env = os.environ.copy()
    env.pop("CLAUDECODE", None)

    proc = subprocess.Popen(
        cmd,
        cwd=cwd,
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,
        start_new_session=True,
    )

    with ACTIVE_LOCK:
        ACTIVE_PROC = proc
        ACTIVE_CANCELLED = False
        ACTIVE_STARTED_AT = start_ts
        ACTIVE_PROMPT_PREVIEW = re.sub(r"\s+", " ", prompt)[:80]
        ACTIVE_CHAT_ID = chat_id

    def watchdog() -> None:
        nonlocal timed_out
        if proc.poll() is None:
            timed_out = True
            try:
                os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
            except Exception:
                proc.terminate()

    timer = threading.Timer(CLAUDE_TIMEOUT, watchdog)
    timer.daemon = True
    timer.start()

    try:
        assert proc.stdout is not None
        for raw_line in proc.stdout:
            line = raw_line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue

            if ev.get("session_id") and not discovered_sid:
                discovered_sid = ev["session_id"]

            etype = ev.get("type")
            if etype == "assistant":
                msg = ev.get("message", {})
                for block in msg.get("content", []):
                    if not isinstance(block, dict):
                        continue
                    btype = block.get("type")
                    if btype == "tool_use":
                        tool_count += 1
                        last_tool = block.get("name", "tool")
                    elif btype == "text" and block.get("text"):
                        collected_text_chunks.append(block["text"])
            elif etype == "rate_limit_event":
                rl = ev.get("rate_limit_info", {}).get("unifiedWindows")
                if rl:
                    with STATE_LOCK:
                        STATE["last_rate_limit"] = rl
                        save_state(STATE)
            elif etype == "result":
                if ev.get("session_id"):
                    discovered_sid = ev["session_id"]
                if isinstance(ev.get("result"), str):
                    final_result_text = ev["result"]
                if isinstance(ev.get("permission_denials"), list):
                    denials = ev["permission_denials"]
                is_error = bool(ev.get("is_error"))

            now = time.time()
            if status_msg_id and now - last_edit_ts >= 3.0:
                last_edit_ts = now
                elapsed = int(now - start_ts)
                note = f"⏳ Claude working ({elapsed}s)"
                if last_tool:
                    note += f" • `{last_tool}` ({tool_count} tool{'s' if tool_count != 1 else ''})"
                edit_message(chat_id, status_msg_id, note)

        stderr_text = proc.stderr.read().strip() if proc.stderr else ""
        rc = proc.wait()
    finally:
        timer.cancel()
        stop_typing.set()
        with ACTIVE_LOCK:
            was_cancelled = ACTIVE_CANCELLED
            ACTIVE_PROC = None
            ACTIVE_CANCELLED = False
            ACTIVE_PROMPT_PREVIEW = ""
            ACTIVE_CHAT_ID = None

    if status_msg_id:
        delete_message(chat_id, status_msg_id)

    if discovered_sid and not was_cancelled:
        with STATE_LOCK:
            STATE["session_id"] = discovered_sid
            save_state(STATE)

    if was_cancelled:
        send_message(chat_id, "🛑 Cancelled.", reply_to=msg_id, use_html=False)
        return

    if timed_out:
        send_message(chat_id, f"⏱️ Timed out after {CLAUDE_TIMEOUT}s.", reply_to=msg_id, use_html=False)
        return

    reply = final_result_text.strip() or "\n\n".join(collected_text_chunks).strip()
    if not reply:
        if rc != 0 or is_error:
            reply = f"Claude exited with code {rc}.\n```\n{stderr_text[-1500:]}\n```"
        else:
            reply = "Done."

    if denials:
        blocked_tools = ", ".join(sorted({d.get("tool_name", "?") for d in denials}))
        reply += f"\n\n🛡️ Guardrail blocked: `{blocked_tools}`"

    send_long_reply(chat_id, reply, reply_to=msg_id)


def worker_loop() -> None:
    while True:
        chat_id, msg_id, prompt = JOB_QUEUE.get()
        try:
            run_claude_turn(chat_id, msg_id, prompt)
        except Exception as exc:
            log(f"ERROR in worker_loop: {exc}")
            try:
                send_message(chat_id, f"❌ Bridge error: `{exc}`", reply_to=msg_id)
            except Exception:
                pass
        finally:
            JOB_QUEUE.task_done()


def build_prompt_from_message(msg: dict) -> str | None:
    text = (msg.get("text") or msg.get("caption") or "").strip()
    attachments: list[str] = []

    if "photo" in msg and msg["photo"]:
        best = max(msg["photo"], key=lambda p: p.get("file_size", 0))
        saved = download_telegram_file(best["file_id"], "photo.jpg")
        attachments.append(str(saved))
    elif "document" in msg and msg["document"]:
        doc = msg["document"]
        saved = download_telegram_file(doc["file_id"], doc.get("file_name") or "file.bin")
        attachments.append(str(saved))

    parts: list[str] = []
    reply = msg.get("reply_to_message")
    if isinstance(reply, dict):
        rtext = (reply.get("text") or reply.get("caption") or "").strip()
        if rtext:
            parts.append(f"[Replying to earlier message:\n{rtext[:2000]}\n]")

    for path in attachments:
        parts.append(f"[Telegram attachment saved locally at: {path} — inspect with Read if needed]")

    if text:
        parts.append(text)
    elif attachments:
        parts.append("Please inspect the attached file(s) above.")

    combined = "\n\n".join(parts).strip()
    return combined or None


def main() -> None:
    log("Starting Tonelico Claude Telegram Bridge...")
    me = tg_call("getMe")
    bot_user = me.get("result", {}).get("username", "unknown")
    log(f"Connected as @{bot_user}; strictly locked to user ID {ALLOWED_USER_ID}")
    register_commands()

    worker = threading.Thread(target=worker_loop, daemon=True)
    worker.start()

    offset = int(STATE.get("update_offset") or 0)
    while True:
        try:
            resp = tg_call(
                "getUpdates",
                {"offset": offset, "timeout": 30, "allowed_updates": ["message"]},
                timeout=40,
            )
            for upd in resp.get("result", []):
                offset = upd["update_id"] + 1
                with STATE_LOCK:
                    STATE["update_offset"] = offset
                    save_state(STATE)

                msg = upd.get("message")
                if not isinstance(msg, dict):
                    continue
                sender = msg.get("from", {})
                chat = msg.get("chat", {})
                if sender.get("id") != ALLOWED_USER_ID or chat.get("type") != "private":
                    log(f"BLOCKED unauthorized message from user={sender.get('id')} chat={chat.get('id')}")
                    continue

                chat_id = chat["id"]
                msg_id = msg["message_id"]
                with STATE_LOCK:
                    if STATE.get("chat_id") != chat_id:
                        STATE["chat_id"] = chat_id
                        save_state(STATE)

                raw_text = (msg.get("text") or "").strip()
                if raw_text.startswith("/"):
                    if handle_command(chat_id, msg_id, raw_text):
                        continue

                prompt = build_prompt_from_message(msg)
                if not prompt:
                    continue

                with ACTIVE_LOCK:
                    busy = ACTIVE_PROC is not None and ACTIVE_PROC.poll() is None

                try:
                    JOB_QUEUE.put_nowait((chat_id, msg_id, prompt))
                    if busy:
                        send_message(chat_id, "📥 Queued behind active task…", reply_to=msg_id, use_html=False)
                except queue.Full:
                    send_message(chat_id, "⚠️ Queue full — send `/stop` or wait for current tasks.", reply_to=msg_id)
        except KeyboardInterrupt:
            break
        except Exception as exc:
            log(f"Polling error: {exc}")
            time.sleep(3)


if __name__ == "__main__":
    main()
