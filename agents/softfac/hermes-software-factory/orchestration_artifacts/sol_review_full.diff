+    def test_single_writer_lock_prevents_concurrent_execution(self) -> None:
+        from hermes_factory_v2 import FactoryError, FactoryEngine
+        with tempfile.TemporaryDirectory() as td:
+            repo = make_repo(Path(td))
+            engine = FactoryEngine(state_root=Path(td) / "runs")
+            run_dir = Path(td) / "runs" / "test-run"
+            run_dir.mkdir(parents=True)
+            lock_dir = run_dir / ".run.lock.d"
+            lock_dir.mkdir(parents=True)
+            info_file = lock_dir / "info.json"
+
+            # Spawn a real child process whose liveness we control deterministically
+            import subprocess, sys
+            holder_script = run_dir / "_holder.py"
+            holder_script.write_text(
+                "import os, sys, time, json\n"
+                "lock_path = sys.argv[1]\n"
+                "fd = os.open(lock_path, os.O_CREAT | os.O_RDWR)\n"
+                "if sys.platform == 'win32':\n"
+                "    import msvcrt\n"
+                "    os.lseek(fd, 0, os.SEEK_SET)\n"
+                "    msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)\n"
+                "else:\n"
+                "    import fcntl\n"
+                "    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)\n"
+                "os.lseek(fd, 1, os.SEEK_SET)\n"
+                "os.write(fd, json.dumps({'pid': os.getpid()}).encode('utf-8'))\n"
+                "os.fsync(fd)\n"
+                "sys.stdout.write('READY\\n')\n"
+                "sys.stdout.flush()\n"
+                "time.sleep(30)\n",
+                encoding="utf-8",
+            )
+            proc_exe = getattr(sys, "_base_executable", sys.executable)
+            proc = subprocess.Popen([proc_exe, str(holder_script), str(run_dir / ".run.lock")], stdout=subprocess.PIPE)
+            proc.stdout.readline()  # wait for READY
+            try:
+                
+                # Creating sol_plan.json and run_state.json to invoke execute
+                import dataclasses
+                config_dict = dataclasses.asdict(self.config())
+                state = {"phase": "planned", "branch": "test-branch", "config": config_dict}
+                (run_dir / "run_state.json").write_text(json.dumps(state))
+                plan = {"allowed_files": ["calc.py"], "implementation_steps": ["step 1"]}
