+def _is_pid_alive(pid: int) -> bool:
+    if pid <= 0:
+        return False
+    try:
+        import psutil
+        p = psutil.Process(pid)
+        return p.is_running() and p.status() != psutil.STATUS_ZOMBIE
+    except (ImportError, Exception):
+        pass
+    if sys.platform == "win32":
+        try:
+            import ctypes
+            from ctypes import wintypes
+            kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+            kernel32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
+            kernel32.OpenProcess.restype = wintypes.HANDLE
+            kernel32.WaitForSingleObject.argtypes = [wintypes.HANDLE, wintypes.DWORD]
+            kernel32.WaitForSingleObject.restype = wintypes.DWORD
+            kernel32.CloseHandle.argtypes = [wintypes.HANDLE]
+            kernel32.CloseHandle.restype = wintypes.BOOL
+
+            SYNCHRONIZE = 0x00100000
+            handle = kernel32.OpenProcess(SYNCHRONIZE, False, pid)
+            if not handle:
+                # If access denied, process definitely exists!
+                err = ctypes.get_last_error()
+                ERROR_ACCESS_DENIED = 5
+                if err == ERROR_ACCESS_DENIED:
+                    return True
+                return False
+            try:
+                # 258 is WAIT_TIMEOUT, meaning process is still active; 0 means signaled/terminated
+                wait_res = kernel32.WaitForSingleObject(handle, 0)
+                if wait_res == 258:
+                    return True
+                if wait_res == 0:
+                    return False
+                # Any other wait result (WAIT_FAILED, etc.): fail closed!
+                return True
+            finally:
+                kernel32.CloseHandle(handle)
+        except Exception:
+            return True  # Fail-closed on error: assume alive to prevent race
+    else:
+        try:
+            os.kill(pid, 0)
+            return True
+        except PermissionError:
+            # Process exists but owned by different user
+            return True
+        except ProcessLookupError:
+            # Explicit: no such process
+            return False
+        except OSError:
+            # Unexpected OS error: fail closed
+            return True
+
+
+class SingleWriterLock:
+    def __init__(self, lock_file: Path, identifier: str):
+        self.lock_file = lock_file
+        self.identifier = identifier
+        self.fd: int | None = None
+        self.acquired = False
+        self.pid = os.getpid()
+
+    def acquire(self) -> None:
+        self.lock_file.parent.mkdir(parents=True, exist_ok=True)
+        try:
+            fd = os.open(str(self.lock_file), os.O_CREAT | os.O_RDWR)
+        except OSError as e:
+            raise FactoryError(f"run {self.identifier} lock open failed: {e}", "lock")
+
+        if sys.platform == "win32":
+            import msvcrt
+            try:
+                os.lseek(fd, 0, os.SEEK_SET)
+                msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)
+            except OSError:
+                owner_pid = self._read_owner_pid(fd)
+                os.close(fd)
+                if owner_pid > 0 and _is_pid_alive(owner_pid):
+                    raise FactoryError(f"run {self.identifier} is locked by active process {owner_pid}", "lock")
+                raise FactoryError(f"run {self.identifier} is locked by active process", "lock")
+        else:
+            import fcntl
+            try:
+                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except OSError:
+                owner_pid = self._read_owner_pid(fd)
+                os.close(fd)
+                if owner_pid > 0 and _is_pid_alive(owner_pid):
+                    raise FactoryError(f"run {self.identifier} is locked by active process {owner_pid}", "lock")
+                raise FactoryError(f"run {self.identifier} is locked by active process", "lock")
+
+        self.fd = fd
+        self.acquired = True
+        try:
+            lock_payload = json.dumps({"pid": self.pid, "time": time.time()}).encode("utf-8")
+            os.lseek(fd, 1, os.SEEK_SET)
+            os.write(fd, lock_payload)
+            os.fsync(fd)
+        except Exception:
+            pass
+
+    def _read_owner_pid(self, fd: int) -> int:
+        try:
+            os.lseek(fd, 1, os.SEEK_SET)
+            data = os.read(fd, 512).decode("utf-8", errors="ignore")
+            if data:
+                return int(json.loads(data).get("pid", 0))
+        except Exception:
+            pass
+        return 0
+
+    def release(self) -> None:
+        if self.acquired and self.fd is not None:
+            try:
+                if sys.platform == "win32":
+                    import msvcrt
+                    try:
+                        os.lseek(self.fd, 0, os.SEEK_SET)
+                        msvcrt.locking(self.fd, msvcrt.LK_UNLCK, 1)
+                    except Exception:
+                        pass
+                else:
+                    import fcntl
+                    try:
+                        fcntl.flock(self.fd, fcntl.LOCK_UN)
+                    except Exception:
+                        pass
+                os.close(self.fd)
+            except Exception:
+                pass
+            finally:
+                self.fd = None
+                self.acquired = False
+
+def extract_step_contract(request: str) -> tuple[int, int]:
+    req_lower = request.lower()
+    # 1. Exact "one step" keywords
+    if (
+        "one implementation step only" in req_lower
+        or "exactly one implementation step" in req_lower
+        or "one step only" in req_lower
+        or "single implementation step" in req_lower
+        or "single step" in req_lower
+    ):
+        return 1, 1
+
+    # 2. Range: between N and M steps / N to M steps
+    m_between = re.search(r"\bbetween\s+(\d+)\s+and\s+(\d+)\s+steps?\b", req_lower)
+    if m_between:
+        low, high = int(m_between.group(1)), int(m_between.group(2))
+        if low < 1 or high < low:
+            raise FactoryError(f"invalid step range contract: between {low} and {high}", "contract")
+        return max(1, low), min(8, high)
+
+    m_range = re.search(r"\b(\d+)\s*(?:to|-)\s*(\d+)\s+steps?\b", req_lower)
+    if m_range:
+        low, high = int(m_range.group(1)), int(m_range.group(2))
+        if low < 1 or high < low:
+            raise FactoryError(f"invalid step range contract: {low} to {high}", "contract")
+        return max(1, low), min(8, high)
+
+    # 3. Min bound: at least N steps / min N steps / minimum N steps
+    m_min = re.search(r"\b(?:at least|min(?:imum)?)\s+(\d+)\s+steps?\b", req_lower)
+    if m_min:
+        n = int(m_min.group(1))
+        if n < 1:
+            raise FactoryError(f"invalid min steps contract: {n}", "contract")
+        return max(1, min(8, n)), 8
+
+    # 4. Max bound: at most N steps / no more than N steps / max N steps / maximum N steps
+    m_max = re.search(r"\b(?:at most|no more than|max(?:imum)?)\s+(\d+)\s+steps?\b", req_lower)
+    if m_max:
+        n = int(m_max.group(1))
+        if n < 1:
+            raise FactoryError(f"invalid max steps contract: {n}", "contract")
+        return 1, min(8, n)
+
+    # 5. Exact: in N steps / exactly N steps / N implementation steps
+    m_exact = re.search(r"\b(?:in|exactly)\s+(\d+)\s+(?:implementation\s+)?steps?\b", req_lower)
+    if not m_exact:
+        m_exact = re.search(r"\b(\d+)\s+implementation\s+steps?\b", req_lower)
+    if m_exact:
+        n = int(m_exact.group(1))
+        if n < 1:
+            raise FactoryError(f"invalid exact steps contract: {n}", "contract")
+        return min(8, n), min(8, n)
+
+    return 1, 8
+
