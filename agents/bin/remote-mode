#!/usr/bin/env bash
# Remote mode: keep the laptop awake (including lid closed) and run Sunshine.
#   remote-mode on | off | status
set -u
UNIT=remote-mode-inhibit
case "${1:-status}" in
  on)
    systemctl --user start sunshine
    systemctl --user is-active --quiet $UNIT || \
      systemd-run --user --unit=$UNIT --collect \
        systemd-inhibit --what=sleep:handle-lid-switch:handle-suspend-key \
        --who=remote-mode --why="Remote mode: Moonlight session" --mode=block sleep infinity >/dev/null
    echo "remote mode ON: sunshine=$(systemctl --user is-active sunshine) inhibit=$(systemctl --user is-active $UNIT) ip=$(tailscale ip -4 2>/dev/null | head -1)"
    ;;
  off)
    systemctl --user stop $UNIT 2>/dev/null
    systemctl --user stop sunshine
    echo "remote mode OFF: sunshine=$(systemctl --user is-active sunshine) inhibit=$(systemctl --user is-active $UNIT 2>/dev/null || echo inactive)"
    ;;
  status)
    echo "sunshine=$(systemctl --user is-active sunshine) inhibit=$(systemctl --user is-active $UNIT 2>/dev/null || echo inactive) ip=$(tailscale ip -4 2>/dev/null | head -1)"
    ;;
  *) echo "usage: remote-mode on|off|status" >&2; exit 2 ;;
esac
