#!/usr/bin/env bash
set -euo pipefail
export PATH="/run/wrappers/bin:/run/current-system/sw/bin:/etc/profiles/per-user/aesc/bin:/home/aesc/.nix-profile/bin:/home/aesc/.local/bin:${PATH:-}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"

URL="http://134.185.85.64:2048/"

# Launch remote AIStudio2API dashboard in LibreWolf (local service stays off)
nohup librewolf "$URL" >/dev/null 2>&1 &
