[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target aistudio2api.service
Wants=network-online.target aistudio2api.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=@HERMES_ENV@/bin/python -m hermes_cli.main gateway run
WorkingDirectory=/home/aesc/.hermes
Environment="PATH=@HERMES_ENV@/bin:/home/aesc/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=@HERMES_ENV@"
Environment="HERMES_HOME=/home/aesc/.hermes"
Environment="HERMES_SUPERVISED_CHILD=1"
Restart=always
RestartSec=5
RestartForceExitStatus=75
SuccessExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStop=-@HERMES_ENV@/bin/python -m gateway.systemd_stop_mark
ExecStopPost=-@HERMES_ENV@/bin/python -m gateway.cgroup_cleanup
TimeoutStopSec=70
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
