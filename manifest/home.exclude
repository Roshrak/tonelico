# rsync patterns applied to every entry in manifest/home.list.

# Backups, caches, locks and generated bytecode
*.before-*
*.bak
*.bak-*
*.bak.*
*.audio-backup
*.orig
*.tmp
*.lock
*~
__pycache__/
*.pyc
.cache/

# Nested git repositories (would become accidental submodules)
.git/
.git

# Personal runtime data that lives next to the theme state
clipboard
clipboard/
notification_history*
recently_used.json
usage_counts.json
.noctalia-cache.json
plugins/sources/
*.db
*.db-*
*.sqlite*
*.log
