# Names of the secrets install.sh asks for. The real file lives only on your machine at
#   ~/.config/tonelico/secrets.env   (mode 600, never uploaded)
# Leave a value empty to skip that feature.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
BROWSER_USE_API_KEY=
# Generated automatically when empty:
AGY_ROTATOR_API_KEY=
WEB_PASSWORD=
