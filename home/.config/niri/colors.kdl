layout {

    focus-ring {
        active-color   "#89d990"
        inactive-color "#091516"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#89d990"
        inactive-color "#091516"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#89d990"
        inactive-color "#00531e"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#89d99080"
    }
}

recent-windows {
    highlight {
        active-color "#89d990"
        urgent-color "#ffb4ab"
    }
}
